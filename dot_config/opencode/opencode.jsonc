{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "./profile.yaml"
  ],
  "autoupdate": "notify",
  "default_agent": "opencode-go/deepseek-v4-flash",
  "permission": {
    "git reset": "deny",
    "sudo": "ask",
    "rm -rf": "ask"
  },
  "mcp": {
    "markitdown": {
      "type": "local",
      "command": [
        "uvx",
        "markitdown-mcp"
      ],
      "enabled": false
    },
    "mise": {
      "type": "local",
      "command": [
        "mise",
        "mcp"
      ],
      "enabled": true
    }
  },
  "lsp": true,
  "plugin": [
    [
      "@plannotator/opencode@latest",
      {
        "workflow": "plan-agent",
        "planningAgents": [
          "plan",
          "orchestrator"
        ],
      },
    ],
    "@tarquinen/opencode-dcp@latest",
    "opencode-vibeguard",
    "oh-my-opencode-slim"
  ],
  "agent": {
    "build": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "plan": {
      "color": "#2C05FF"
    },
    "study": {
      "prompt": "load this skill",
      "color": "#2CFF05"
    }
  }
}