    layout {
        gaps 16 // Gap between windows
        center-focused-column "never" // Don’t auto-center focused column

        background-color "transparent" // <- needed for noctalia-shell to set wallpaper

        preset-column-widths {
            proportion 0.333
            proportion 0.5
            proportion 0.667
        }

        default-column-width { proportion 0.667; }

        struts {}
    }

    input {
        // Limits focus-follows-mouse to only windows that are fully visible.
        // Setting this to "0%" prevents the mouse from switching focus to
        // any window that isn't already taking up the whole view.
        focus-follows-mouse max-scroll-amount="0%"
    }

    window-rule {
        match app-id="Alacritty"
        default-column-width { proportion 0.5; }
    }

    window-rule {
        match app-id="zen-browser"
        default-column-width { proportion 0.7; }
    }

    window-rule {
        match app-id="postman"
        default-column-width { proportion 0.5; }
    }

    window-rule {
        match app-id="org.gnome.Nautilus"
        default-column-width { proportion 0.33; }
    }